@@ -0,0 +1,77 @@
+.pilot-checklist { position:absolute; inset:0; z-index:12; pointer-events:none; color:#eaf0f2; font-family:Barlow,system-ui,sans-serif; }
+.pilot-checklist[hidden], .pilot-checklist [hidden] { display:none !important; }
+.pilot-checklist *, .pilot-checklist *::before, .pilot-checklist *::after { box-sizing:border-box; }
+.pilot-checklist button { font-family:inherit; cursor:pointer; }
