+// Standalone pilot checklist for Skyhawk. This module does not install a key handler
+// or reposition the aircraft; the simulator host supplies those integrations.
+const INSPECTION_IDS = ['propeller', 'leftWing', 'rightWing', 'fuel', 'gear', 'tail'];
+const SECTIONS = [
+  { id: 'preflight', number: '01', name: 'Pre-flight', subtitle: 'Inspect & prepare' },
+  { id: 'start', number: '02', name: 'Engine start', subtitle: 'Bring the aircraft to life' },
+  { id: 'takeoff', number: '03', name: 'Before takeoff', subtitle: 'Final cockpit checks' },
+  { id: 'shutdown', number: '04', name: 'Shutdown', subtitle: 'After landing & parking' },
+];
+const finite = (n) => typeof n === 'number' && Number.isFinite(n);
+const inRange = (n, low, high) => finite(n) && n >= low && n <= high;
+const isStopped = (f) => !!f?.onGround && Array.isArray(f.vel) && finite(f.vel[0]) && finite(f.vel[2]) && Math.hypot(f.vel[0], f.vel[2]) < 1 && !f.crashed;
+const walkaroundSafe = (sim) => {
+  const f = sim?.fdm, e = f?.eng, s = f?.sys;
+  return !!(sim?.started && f?.onGround && !f.crashed && Array.isArray(f.vel) && f.vel.length >= 3 && f.vel.every(finite) && Math.hypot(...f.vel) < 0.75 && f.ctrl?.parkBrake === true && e?.running === false && finite(e.rpm) && Math.abs(e.rpm) <= 0.5 && finite(e.propOmega) && Math.abs(e.propOmega) <= 0.5 * Math.PI / 30 && s?.mags === 0 && !s.starter && !(sim.startHeld > 0) && !sim.autoStarting);
+};
+const isCarb = (f) => f?.aircraft?.carb === true;
+const fuelOpen = (s) => s?.fuelSel === 'BOTH' && s.fuelShutoff === true;
+const bothTanks = (s) => finite(s?.fuelL) && finite(s?.fuelR) && s.fuelL > 0.05 && s.fuelR > 0.05;
+const rich = (c) => finite(c?.mixture) && c.mixture >= 0.95;
+const avionicsOn = (f) => f?.sys?.avionics === true && (isCarb(f) || f.sys.avionics2 === true);
+const item = (id, title, detail, mode, done, extra = {}) => ({ id, title, detail, mode, done: !!done, ...extra });
+
+// Sampling must run on every simulation frame, even while the tablet is closed.
+// Historical observations represent only the stated action/position, not a full procedure.
+export function createChecklistTracker() {
+  let history = {};
+  let manual = {};
+  let inspected = {};
+
+  function sample(sim) {
+    const f = sim?.fdm, s = f?.sys, c = f?.ctrl, e = f?.eng;
+    if (!sim?.started || !f || !s || !c || !e) return;
+    const beforeStart = !!f.onGround && e.running === false;
+    if (e.running === true) history.wasRunning = true;
+    if (f.onGround && c.parkBrake === true) history.parkingBrake = true;
+    if (beforeStart && s.avionics === false && (isCarb(f) || s.avionics2 === false)) history.avionicsOff = true;
+    if (beforeStart && inRange(c.throttle, 0.04, 0.18)) history.startThrottle = true;
+    if (beforeStart && finite(e.oilT) && e.oilT >= 110) history.warmStart = true;
+    if (beforeStart && (isCarb(f) ? finite(s.primer) && s.primer >= 1 : finite(s.primeT) && s.primeT >= 1)) history.primed = true;
+    if (f.onGround && s.mags === 4) history.starter = true;
+  }
+
+  function snapshot(sim) {
+    const f = sim?.fdm || {}, s = f.sys || {}, c = f.ctrl || {}, e = f.eng || {}, av = sim?.av || {};
+    const carb = isCarb(f);
+    const shutdownActive = !!history.wasRunning && !!f.onGround;
+    const qnh = sim?.weather?.qnhInHg;
+    const flapTarget = c.flaps === 0 ? 0 : c.flaps === 1 ? 10 : null;
+    const inspection = (id, title, detail) => item('inspect-' + id, title, detail, 'inspection', inspected[id]);
+    const manualItem = (id, title, detail) => item(id, title, detail, 'manual', manual[id]);
+    const live = (id, title, detail, done) => item(id, title, detail, 'live', done);
+    const observed = (id, title, detail, done, extra) => item(id, title, detail, 'observed', done, extra);
+    const primeDetail = carb
+      ? 'Cold engine: use the panel primer. Warm engine: prime as needed.'
+      : 'Cold engine: master ON, fuel available, mixture rich; run the fuel pump for at least 1 second.';
+    const priming = observed('prime', 'Prime engine, if cold', primeDetail, history.primed || history.warmStart,
+      { status: history.primed ? 'OBSERVED' : history.warmStart ? 'WARM ENGINE' : undefined });
+    return {
+      preflight: [
+        manualItem('plan', 'Flight plan & weather', 'Review weather, route, weight and balance, and fuel for the intended flight.'),
+        observed('parking', 'Parking brake — set', 'P or the panel handle. Recorded when set on the ground.', history.parkingBrake),
+        live('fuel-present', 'Fuel — present in both tanks', `L ${finite(s.fuelL) ? s.fuelL.toFixed(1) : '—'} / R ${finite(s.fuelR) ? s.fuelR.toFixed(1) : '—'} gal · Presence only, not a fuel-planning check.`, bothTanks(s)),
+        inspection('propeller', 'Propeller & nose', 'Inspect the propeller and nose area.'),
+        inspection('leftWing', 'Left wing', 'Inspect the left wing and surfaces.'),
+        inspection('rightWing', 'Right wing', 'Inspect the right wing and surfaces.'),
+        inspection('fuel', 'Fuel & caps', 'Inspect fuel caps, vents and drains.'),
+        inspection('gear', 'Landing gear', 'Inspect wheels, tires and gear.'),
+        inspection('tail', 'Tail & empennage', 'Inspect tail and control surfaces.'),
+        manualItem('belts', 'Doors, seats & belts', 'Secure doors and adjust seats and belts. Not modeled.'),
+      ],
+      start: [
+        observed('avionics-off', 'Avionics — OFF before start', 'Shift+V or panel switch. Recorded while the engine is stopped.', history.avionicsOff),
+        observed('start-brake', 'Parking brake — set', 'P or panel handle. Recorded on the ground.', history.parkingBrake),
+        live('start-fuel', carb ? 'Fuel valve — ON' : 'Fuel selector BOTH · shutoff ON', 'Use the floor selector and, on the 172, pedestal shutoff.', fuelOpen(s)),
+        live('master', 'Master BAT + ALT — ON', 'Shift+M or panel switches.', s.master === true && s.alternator === true),
+        live('beacon', 'Beacon — ON', 'Use the panel beacon switch.', s.beacon === true),
+        live('start-mixture', 'Mixture — RICH', 'Hold ] or use the red panel knob.', rich(c)),
+        observed('start-throttle', 'Throttle — cracked open', 'W / S or panel knob · observed at 4–18% before start.', history.startThrottle),
+        priming,
+        manualItem('prop-clear', 'Propeller area — CLEAR', 'Look outside and call clear. The simulator cannot verify people or obstructions.'),
+        observed('starter', 'Ignition — START selected', 'Advance with I and hold at START, or use the panel key. Shift+E auto-start also works.', history.starter),
+        live('running', 'Engine running · ignition BOTH', 'Release the starter after the engine catches.', e.running === true && s.mags === 3),
+        live('oil', 'Oil pressure — above low warning', `At least 20 psi while running · ${finite(e.oilP) ? Math.round(e.oilP) + ' psi' : '—'}. This is not a complete engine-health check.`, e.running === true && finite(e.oilP) && e.oilP >= 20),
+        ...(carb ? [] : [live('pump-off', 'Fuel pump — OFF after start', 'Use the panel fuel-pump switch.', e.running === true && s.fuelPump === false)]),
+        live('start-avionics', 'Avionics — ON', 'Shift+V or panel switches after engine start.', e.running === true && avionicsOn(f)),
+      ],
+      takeoff: [
+        manualItem('controls', 'Flight controls — free & correct', 'Move controls through their range and visually verify correct movement.'),
+        manualItem('runup', 'Engine run-up — complete', 'Perform and assess the magneto and engine checks; an acceptable RPM drop is not verified here.'),
+        live('takeoff-fuel', carb ? 'Fuel valve — ON' : 'Fuel selector BOTH · shutoff ON', 'Confirm fuel supply for takeoff.', fuelOpen(s)),
+        live('takeoff-mixture', 'Mixture — RICH', 'Hold ] or use the panel knob. Adjust as appropriate for your procedure and altitude.', rich(c)),
+        ...(carb ? [live('carb-heat', 'Carb heat — COLD', 'Use the carb-heat panel knob.', s.carbHeat === false)] : []),
+        live('flaps', 'Flaps — UP or 10°', `F / V or flap lever · actual ${finite(f.flapPos) ? Math.round(f.flapPos) + '°' : '—'}. Choose the setting appropriate to the departure.`, flapTarget !== null && finite(f.flapPos) && Math.abs(f.flapPos - flapTarget) <= 1.5),
+        live('trim', 'Elevator trim — near neutral', 'Home / End or panel trim wheel · within ±10% of neutral.', finite(c.trim) && Math.abs(c.trim) <= 0.1),
+        live('ignition-both', 'Ignition — BOTH', 'I / Shift+I or the ignition key on the panel.', s.mags === 3),
+        live('takeoff-engine', 'Engine & oil indication', `Engine running; oil pressure ≥20 psi · ${finite(e.oilP) ? Math.round(e.oilP) + ' psi' : '—'}. Check other engine indications yourself.`, e.running === true && finite(e.oilP) && e.oilP >= 20),
+        live('charging', 'Alternator — charging', `BAT + ALT ON, field breaker in and bus ≥26 V · ${finite(e.busV) ? e.busV.toFixed(1) + ' V' : '—'}. The model charges above 900 RPM.`, s.master === true && s.alternator === true && s.alternatorFailed === false && s.cb?.['ALT FLD'] !== false && finite(e.rpm) && e.rpm > 900 && finite(e.busV) && e.busV >= 26),
+        live('altimeter', 'Altimeter — set to QNH', 'K sets the current simulator QNH.', finite(f.kollsman) && finite(qnh) && Math.abs(f.kollsman - qnh) <= 0.011),
+        live('xpdr', 'Transponder — ALT & powered', 'Set ALT on the panel and ensure its avionics bus is powered.', av.xpdr?.mode === 'ALT' && f.eff?.xpdr === true),
+        live('services', 'Ground services — disconnected', 'Shift+J near a service stand. Check visually before moving.', sim?.groundServices?.active === false),
+        manualItem('departure', 'Departure briefing & clearance', 'Brief the departure and confirm runway clearance or traffic as applicable.'),
+      ],
+      shutdown: [
+        manualItem('after-landing', 'After landing & taxi', 'Exit the runway, contact ground as applicable and taxi to a safe parking area.'),
+        live('park-stopped', 'Aircraft — stopped on ground', 'Park safely before shutting down. Shutdown tracking starts after the engine has run.', shutdownActive && isStopped(f)),
+        live('shutdown-brake', 'Parking brake — set', 'P or panel handle.', shutdownActive && c.parkBrake === true),
+        live('shutdown-avionics', 'Avionics — OFF', 'Shift+V or the panel switches.', shutdownActive && s.avionics === false && (carb || s.avionics2 === false)),
+        ...(carb ? [] : [live('shutdown-pump', 'Fuel pump — OFF', 'Use the panel fuel-pump switch.', shutdownActive && s.fuelPump === false)]),
+        live('cutoff', 'Mixture — idle cutoff', 'Hold [ or use the red panel knob.', shutdownActive && finite(c.mixture) && c.mixture <= 0.02),
+        live('engine-stopped', 'Engine — stopped', `Engine not running and RPM below 50 · ${finite(e.rpm) ? Math.round(e.rpm) + ' RPM' : '—'}.`, shutdownActive && e.running === false && finite(e.rpm) && e.rpm < 50),
+        live('mags-off', 'Ignition — OFF', 'Shift+I or panel ignition key.', shutdownActive && s.mags === 0),
+        live('lights-off', 'Lights — OFF', 'Switch off beacon, navigation, strobe, landing and taxi lights on the panel.', shutdownActive && s.beacon === false && s.nav === false && s.strobe === false && s.landing === false && s.taxi === false),
+        live('shutdown-master', 'Master BAT + ALT — OFF', 'Shift+M or the panel switches.', shutdownActive && s.master === false && s.alternator === false),
+      ],
+    };
+  }
+
+  return {
+    sample, snapshot,
+    setInspected(id, value = true) {
+      if (!INSPECTION_IDS.includes(id)) return false;
+      inspected[id] = value === true;
+      return true;
+    },
+    setManual(id, value = true) { manual[id] = value === true; },
+    reset() { history = {}; manual = {}; inspected = {}; },
+  };
+}
+
+/** Create the tablet. Call update() each frame and wire Tab in the host input handler. */
+export function createPilotChecklist({ sim, mount = document.getElementById('hud') || document.body, onStartWalkaround, onSkipToRunway } = {}) {
+  if (!sim) throw new Error('createPilotChecklist requires the simulator object');
+  const tracker = createChecklistTracker();
+  const root = document.createElement('div');
+  root.className = 'pilot-checklist';
+  root.innerHTML = `
+    <button type="button" class="pc-launch" aria-label="Open pilot checklist" aria-expanded="false" title="Pilot checklist · Tab">
+      <span class="pc-launch-icon" aria-hidden="true">✓</span><span>CHECKLIST</span><kbd>TAB</kbd>
+    </button>
+    <section class="pc-tablet" aria-label="Pilot checklist" hidden>
+      <div class="pc-topline"><span><i></i> FLIGHT DECK / FIELD GUIDE</span><span class="pc-aircraft">C172S</span></div>
+      <header class="pc-header"><div><span class="pc-eyebrow">PILOT'S COMPANION</span><h2>Pilot checklist<span class="pc-title-dot">.</span></h2><p>Prepare deliberately. Fly confidently.</p></div><button class="pc-close" type="button" aria-label="Close checklist" title="Close · Tab">×</button></header>
+      <div class="pc-progress"><div class="pc-progress-copy"><span>CURRENT SECTION</span><strong class="pc-count">0 / 0</strong></div><div class="pc-progress-track"><div class="pc-progress-fill"></div></div></div>
+      <nav class="pc-tabs" aria-label="Checklist sections"></nav>
+      <div class="pc-content"><div class="pc-section-heading"><div><span class="pc-section-index">01 / 04</span><h3 class="pc-section-title">Pre-flight</h3><p class="pc-section-subtitle">Inspect &amp; prepare</p></div><span class="pc-section-count"></span></div>
+        <div class="pc-items"></div>
+        <button type="button" class="pc-walk"><span>↗</span><span>Start walkaround<small>Inspect the aircraft exterior</small></span><b>7</b></button>
+        <div class="pc-notice" role="status" hidden></div>
+      </div>
+      <footer class="pc-footer"><button type="button" class="pc-skip">Skip to ready on runway <span>↗</span></button><div class="pc-confirm" hidden><p>Restart on the nearest available runway with the engine running? Fuel and ATC reset to the flight setup; failures are cleared and the start-of-flight failure is disabled for this quick flight. Unperformed checks remain unverified.</p><div><button type="button" class="pc-cancel">Cancel</button><button type="button" class="pc-confirm-skip">Place on runway</button></div></div><p>SIMULATION ONLY · NOT A REAL-WORLD CHECKLIST</p></footer>
+    </section>`;
+  mount.appendChild(root);
+  const $ = (selector) => root.querySelector(selector);
+  const launch = $('.pc-launch'), tablet = $('.pc-tablet'), tabs = $('.pc-tabs'), list = $('.pc-items');
+  let section = 'preflight', open = false, renderedProfile = null, skipBusy = false, destroyed = false, lastPaint = 0;
+  let lastSnapshot = null;
