+// Run with: node --experimental-default-type=module --test tests/checklist.test.mjs
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createChecklistTracker } from '../src/pilot-checklist.js';
+
+function makeSim(carb = false) {
+  return {
+    started: true,
+    weather: { qnhInHg: 30.02 },
+    groundServices: { active: false },
+    av: { xpdr: { mode: 'ALT' } },
+    fdm: {
+      aircraft: { carb }, onGround: true, vel: [0, 0, 0], crashed: null,
+      ctrl: { parkBrake: true, throttle: 0, mixture: 0, flaps: 0, trim: 0 }, flapPos: 0,
+      sys: { master: false, alternator: false, avionics: false, avionics2: false,
+        beacon: false, fuelL: 20, fuelR: 20, fuelSel: 'BOTH', fuelShutoff: true,
+        fuelPump: false, primer: 0, primeT: 0, mags: 0, carbHeat: false, cb: {} },
+      eng: { running: false, rpm: 0, oilT: 70, oilP: 0, busV: 0 }, kollsman: 29.92, eff: { xpdr: false },
+    },
+  };
+}
+const find = (tracker, sim, section, id) => tracker.snapshot(sim)[section].find((entry) => entry.id === id);
+
+test('inspections are explicit and reset clears pilot confirmations', () => {
+  const tracker = createChecklistTracker(), sim = makeSim();
+  tracker.sample(sim);
+  assert.equal(find(tracker, sim, 'preflight', 'inspect-propeller').done, false);
+  assert.equal(tracker.setInspected('not-an-inspection'), false);
+  tracker.setInspected('propeller');
+  tracker.setManual('plan');
+  assert.equal(find(tracker, sim, 'preflight', 'inspect-propeller').done, true);
+  assert.equal(find(tracker, sim, 'preflight', 'plan').done, true);
+  tracker.reset();
+  assert.equal(find(tracker, sim, 'preflight', 'inspect-propeller').done, false);
+  assert.equal(find(tracker, sim, 'preflight', 'plan').done, false);
+  assert.equal(find(tracker, sim, 'preflight', 'parking').done, false);
+});
+
+test('live items follow state while transient start actions remain observed', () => {
+  const tracker = createChecklistTracker(), sim = makeSim(), f = sim.fdm;
+  f.ctrl.throttle = 0.1;
+  f.sys.primeT = 1.2;
+  f.sys.mags = 4;
+  tracker.sample(sim);
+  assert.equal(find(tracker, sim, 'start', 'prime').done, true);
+  assert.equal(find(tracker, sim, 'start', 'starter').done, true);
+  f.sys.mags = 3; f.sys.master = true; f.sys.alternator = true; f.eng.running = true; f.eng.oilP = 25;
+  tracker.sample(sim);
+  assert.equal(find(tracker, sim, 'start', 'starter').done, true);
+  assert.equal(find(tracker, sim, 'start', 'running').done, true);
+  assert.equal(find(tracker, sim, 'start', 'oil').done, true);
+  f.eng.oilP = 0;
+  assert.equal(find(tracker, sim, 'start', 'oil').done, false);
+  f.sys.fuelL = 0;
+  assert.equal(find(tracker, sim, 'preflight', 'fuel-present').done, false);
+});
+
+test('C152 uses the primer and carb-heat checks; a warm start is not reported as primed', () => {
+  const tracker = createChecklistTracker(), sim = makeSim(true);
+  sim.fdm.eng.oilT = 120;
+  tracker.sample(sim);
+  assert.equal(find(tracker, sim, 'start', 'prime').status, 'WARM ENGINE');
+  assert.equal(find(tracker, sim, 'takeoff', 'carb-heat').done, true);
+  sim.fdm.sys.carbHeat = true;
+  assert.equal(find(tracker, sim, 'takeoff', 'carb-heat').done, false);
+  tracker.reset();
+  sim.fdm.eng.oilT = 70;
+  sim.fdm.sys.primer = 2;
+  tracker.sample(sim);
+  assert.equal(find(tracker, sim, 'start', 'prime').status, 'OBSERVED');
+});
+
+test('shutdown items are not credited before the engine has run', () => {
+  const tracker = createChecklistTracker(), sim = makeSim();
+  tracker.sample(sim);
+  assert.equal(find(tracker, sim, 'shutdown', 'engine-stopped').done, false);
+  sim.fdm.eng.running = true;
+  tracker.sample(sim);
+  sim.fdm.eng.running = false;
+  assert.equal(find(tracker, sim, 'shutdown', 'engine-stopped').done, true);
+});
