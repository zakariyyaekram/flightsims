+    if (!found) continue;
+    const end = runwayEnd(found.r, found.e);
+    const distance = Math.hypot(end.x - F.pos[0], end.z - F.pos[2]);
+    if (distance < bestDistance) { bestDistance = distance; bestSpawn = spawn; }
+  }
+  const retrySetup = lastSetup;
+  applySetup({ ...retrySetup, spawn: bestSpawn, triggerFailureAtStart: false });
