+      m.projected.copy(m.world).project(camera);
+      const p = m.projected;
+      const inView = cameraSpace.z < 0 && p.z >= -1 && p.z <= 1 && Math.abs(p.x) <= 1.28 && Math.abs(p.y) <= 1.28;
+      if (!inView || m.range > showDistance) {
+        m.button.hidden = true; m.line.setAttribute('visibility', 'hidden'); continue;
+      }
+      m.button.hidden = false;
+      m.button.dataset.reviewed = String(reviewed.has(m.station.id));
+      m.dot.textContent = reviewed.has(m.station.id) ? '✓' : '+';
+      m.button.setAttribute('aria-label', `${m.station.label}${reviewed.has(m.station.id) ? ', reviewed' : ''}; open inspection`);
+      m.button.title = m.range <= inspectDistance ? `Inspect ${m.station.label}` : `${m.station.label} — move closer to review`;
+      m.x = rect.left + (p.x + 1) * rect.width / 2;
+      m.y = rect.top + (1 - p.y) * rect.height / 2;
+      candidates.push(m);
+    }
+    // Keep labels inside the canvas and separate them when projected points overlap.
+    // Leaders indicate the true projected component, including when behind the model.
+    candidates.sort((a, b) => a.range - b.range);
+    const markerWidth = window.innerWidth <= 600 ? 126 : 138, markerHeight = 34;
+    const hw = markerWidth / 2, hh = markerHeight / 2;
+    const clamp = (v, min, max) => Math.max(min, Math.min(max, v));
+    for (const m of candidates) {
+      const px = clamp(m.x, left + 4, right - 4), py = clamp(m.y, top + 4, bottom - 4);
+      const baseX = clamp(m.x, left + hw + 4, right - hw - 4), baseY = clamp(m.y, top + hh + 4, bottom - hh - 4);
+      let best = null, bestScore = Infinity;
+      // Search a bounded grid around the anchor; select least overlap, then distance.
+      for (let row = -5; row <= 5; row++) for (let col = -3; col <= 3; col++) {
+        const x = clamp(baseX + col * (markerWidth + 8), left + hw + 4, right - hw - 4);
+        const y = clamp(baseY + row * (markerHeight + 6), top + hh + 4, bottom - hh - 4);
+        let overlaps = 0;
+        for (const a of placed) if (Math.abs(a.x - x) < markerWidth + 5 && Math.abs(a.y - y) < markerHeight + 5) overlaps++;
+        const score = overlaps * 1000000 + (x - baseX) ** 2 + (y - baseY) ** 2;
+        if (score < bestScore) { best = { x, y }; bestScore = score; }
+      }
+      placed.push(best);
+      m.button.style.left = `${best.x}px`; m.button.style.top = `${best.y}px`;
+      m.line.setAttribute('x1', px); m.line.setAttribute('y1', py); m.line.setAttribute('x2', best.x); m.line.setAttribute('y2', best.y);
+      m.line.setAttribute('visibility', 'visible');
+    }
+    if (selected) refreshCard();
+  }
+  refreshCount();
+  return {
+    canEnter: () => walkaroundSafety(sim),
+    update,
+    reset() { reviewed.clear(); closeCard(); refreshCount(); },
+    getInspected() { return [...reviewed]; },
+    dispose() { if (!disposed) { disposed = true; root.remove(); } },
+  };
+}
